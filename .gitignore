# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.mypy_cache/
.ruff_cache/

# --- Node ---
node_modules/
dashboard/dist/
dashboard/.vite/
npm-debug.log*

# --- Env / secrets ---
.env
*.pem
*.key
kaggle.json

# --- Data (generated outputs are regenerated via scripts, not committed) ---
# data/raw/ IS committed: it's the small (1,470-row) IBM HR Analytics dataset,
# checked in so the repo is reproducible without requiring Kaggle credentials.
data/generated/*
!data/generated/.gitkeep

# --- Local LLM backend (LLM_BACKEND=local) ---
# Locally-converted MLX model weights (SQLCoder-7B-2 4-bit, several GB) --
# regenerated via mlx_lm.convert, not committed.
models/

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
*.swp
