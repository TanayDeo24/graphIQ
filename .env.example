# Postgres connection used by src/db/connection.py and docker-compose.yml.
# Local dev default -- discrete POSTGRES_* vars below. In production
# (Neon or any other hosted Postgres), set DATABASE_URL instead: when
# present it takes priority over the POSTGRES_* vars everywhere in this
# project (see src/db/connection.py get_database_url()).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphiq
POSTGRES_USER=graphiq
POSTGRES_PASSWORD=graphiq_dev_password
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Vite) — base URL the dashboard uses to reach the API. Local
# dev value below; in production this is a compile-time Vite env var set
# in Cloudflare Pages/Workers' build config, not read at runtime.
VITE_API_BASE_URL=http://localhost:8000

# CORS: the deployed Cloudflare Workers dashboard origin the FastAPI
# backend should accept requests from in production (in addition to the
# local dev origins, which are always allowed). Leave unset in local dev.
# CORS_ALLOWED_ORIGIN=https://graphiq-dashboard.<your-subdomain>.workers.dev

# --- Explainability agent (src/agent/) ---------------------------------
# LLM_BACKEND selects the entire agent LLM backend, switched with no other
# code changes anywhere else in src/agent/ (see src/agent/llm_backend.py):
#   local      -- MLX on an Apple Silicon Mac (SQLCoder-7B-2 for SQL, a
#                 small 3B instruct model for routing/synthesis/general,
#                 BGE via sentence-transformers for embeddings). Free,
#                 dev-only -- requires macOS + mlx/mlx-lm, not installed
#                 on Linux (see the sys_platform=="darwin" markers in
#                 requirements.txt).
#   cloudflare -- Cloudflare Workers AI REST API. Production backend,
#                 works anywhere (Render, CI, etc). Requires
#                 CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN below.
LLM_BACKEND=local

# Local backend (LLM_BACKEND=local) -- optional overrides, all default to
# a working combination already verified on this project:
# LOCAL_SQLCODER_PATH=models/sqlcoder-7b-2-4bit
# LOCAL_GENERAL_MODEL=mlx-community/Qwen2.5-3B-Instruct-4bit
# LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Cloudflare backend (LLM_BACKEND=cloudflare) -- required.
# CLOUDFLARE_ACCOUNT_ID / CLOUDFLARE_API_TOKEN: from the Cloudflare
# dashboard (Workers AI needs an API token with Workers AI edit
# permission).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model IDs -- verified live against this project's Cloudflare account.
# NOTE: @cf/defog/sqlcoder-7b-2 (the model originally specified for SQL)
# returns HTTP 410 Gone (deprecated) as of this build -- substituted with
# @cf/qwen/qwen2.5-coder-32b-instruct, the closest current live
# code/SQL-capable model. See src/agent/cloudflare_backend.py's docstring
# and the README's Explainability agent section for the full finding.
CLOUDFLARE_SQLCODER_MODEL=@cf/qwen/qwen2.5-coder-32b-instruct
CLOUDFLARE_GENERAL_MODEL=@cf/meta/llama-3.2-3b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# Read-only Postgres role for the explainability agent's text-to-SQL
# pipeline (src/agent/sql_agent.py) -- SELECT-only on validated result
# tables, zero access to raw source tables. Run `python -m
# src.db.agent_readonly` (see README setup instructions) to create the
# role against whichever database DATABASE_URL/POSTGRES_* currently
# point at; it prints a generated password the first time, which you
# then add here.
AGENT_READONLY_DB_USER=graphiq_agent_readonly
AGENT_READONLY_DB_PASSWORD=
