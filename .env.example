# Postgres connection used by src/db/connection.py and docker-compose.yml
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphiq
POSTGRES_USER=graphiq
POSTGRES_PASSWORD=graphiq_dev_password

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Frontend (Vite) — base URL the dashboard uses to reach the API
VITE_API_BASE_URL=http://localhost:8000

# Explainability agent (src/agent/) — Gemini API key from https://ai.google.dev/
# (Google AI Studio). Required for POST /api/agent/chat; the dashboard's chat
# panel and the agent eval suite (src/agent/eval/) will not work without it.
GEMINI_API_KEY=
# Optional: override the Gemini model used (defaults to gemini-3.5-flash-lite --
# chosen after gemini-2.5-flash's free-tier daily quota (20 requests/day) proved
# too low to run the eval suite; the -lite variant is still Flash-family and
# has a materially higher free-tier quota)
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: override the base URL agent tools use to call this project's own
# API (defaults to http://localhost:8000 — only change if the API runs elsewhere)
# AGENT_API_BASE_URL=http://localhost:8000
